generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SocialPost {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topic       String
  contentLI   String?
  contentIG   String?
  imagePrompt String?
  imageUrl    String?

  status      String   @default("draft") // draft | scheduled | published | failed
  scheduledAt DateTime?
  publishedAt DateTime?

  linkedinPostId  String?
  instagramPostId String?
  errorMessage    String?
}

model SocialConfig {
  id               Int      @id @default(1)
  companyName      String   @default("Levad")
  companyDesc      String   @default("Levad est spécialisé dans les solutions d'impression, téléphonie, informatique et GED pour les entreprises.")
  tone             String   @default("professionnel")
  targetAudience   String   @default("dirigeants et responsables IT de PME")
  topics           String   @default("impression,téléphonie,informatique,GED,productivité")
  notifyEmail      String   @default("mobadia@levad.fr")
  linkedinEnabled  Boolean  @default(false)
  instagramEnabled Boolean  @default(false)
  updatedAt        DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Levad Connect : suivi du parc de copieurs des clients (tables séparées de l'outil de publications)
// Script SQL à coller dans la console de la base : prisma/migrations/manual_connect_parc.sql
// ---------------------------------------------------------------------------

model ConnectClient {
  id       Int              @id @default(autoincrement())
  nom      String
  cle      String           @unique // nom simplifié (sans SARL/SAS, accents, majuscules) pour rapprocher les saisies
  creeLe   DateTime         @default(now())
  machines ConnectMachine[]
  mouvements ConnectStockMouvement[]
  minimums ConnectStockMinimum[]
  postes   ConnectPoste[]
  commandes ConnectCommande[]
  evenementsLien ConnectLienEvenement[]
  // Lien personnel d'installation (permanent, lié au client et non à un PC ; régénérable)
  codeLien              String?   @unique
  ipsManuelles          String? // adresses IP de copieurs que la recherche automatique ne trouve pas (une par ligne), lues en plus à chaque relevé
  codeEspace            String?   @unique // lien privé de l'espace client (consultation du parc)
  email                 String? // pour envoyer le lien au client
  modeReleve            String    @default("agent") // agent = programme résident ; manuel = relevés reçus par mail
  seuilDeconnexionJours Int       @default(10)
  deconnexionSignaleLe  DateTime? // mail de déconnexion déjà envoyé (remis à zéro quand le client se reconnecte)
  lienEnvoyeLe          DateTime? // dernier envoi du lien d'installation au client (mail ou marqué à la main)
  moisFacturation       Int? // 1, 2 ou 3 : facturation trimestrielle (1 = janvier/avril/juillet/octobre, 2 = février/…, 3 = mars/…)

  @@map("connect_client")
}

model ConnectMachine {
  id          Int             @id @default(autoincrement())
  clientId    Int
  client      ConnectClient   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  cle         String          @unique // « sn:NUMERO_DE_SERIE » ou « ip:ID_CLIENT:ADRESSE_IP »
  numeroSerie String?
  marque      String?
  modele      String?
  ip          String?
  nomAffiche  String?
  nomReseau   String? // nom donné à la machine par le client (ex. DFM-Compta), tel que la machine le déclare
  modeleFixe  Boolean         @default(false) // la référence a été trouvée / fixée : la lecture automatique ne la remplace plus
  sysDescr    String? // description technique déclarée par la machine (aide à reconnaître le modèle)
  categorie   String          @default("mine") // mine = Canon vendue par LEVAD, autre = autre marque
  horsContrat Boolean         @default(false)
  site        String          @default("Site principal")
  gamme       String?
  aVerifier   Boolean         @default(false)
  recette     String? // A, B ou C ; vide = automatique
  seuilEncre  Int             @default(25) // ancien réglage unique (remplacé par un seuil par couleur)
  seuilNoir    Int            @default(25)
  seuilCyan    Int            @default(25)
  seuilMagenta Int            @default(25)
  seuilJaune   Int            @default(25)
  creeLe      DateTime        @default(now())
  vueLe       DateTime? // null = machine nouvellement découverte, pas encore marquée comme vue
  releves     ConnectReleve[]

  @@index([clientId])
  @@map("connect_machine")
}

model ConnectReleve {
  id            Int            @id @default(autoincrement())
  machineId     Int
  machine       ConnectMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  date          DateTime       @default(now())
  source        String         @default("connect")
  compteurs     Json // { "112": { "v": 656, "nom": "Total (Black/Large)" }, ... }
  encres        Json?
  bacs          Json?
  totalStandard Int?
  versionSnmp   String?
  pc            String?

  @@index([machineId, date])
  @@map("connect_releve")
}

// Stock d'encre d'un client = somme des mouvements (envois +, changements de cartouche détectés -, corrections).
model ConnectStockMouvement {
  id        Int           @id @default(autoincrement())
  clientId  Int
  client    ConnectClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  couleur   String // noir | cyan | magenta | jaune
  delta     Int
  motif     String // envoi | correction | changement
  note      String? // référence de la cartouche, remarque...
  machineId Int?
  variante  String        @default("") // « » = cartouche standard ; sinon le code de la version L / H (ex. « C-EXV 58 L »)
  fournisseurs String? // « Carol », « Copyclic » ou « Carol + Copyclic » (envois)
  groupe    String        @default("") // « site|gamme » : stock partagé par les machines compatibles d'un même site
  date      DateTime      @default(now())

  @@index([clientId, couleur])
  @@map("connect_stock_mouvement")
}

// Stock minimum voulu par le client, par groupe (site + gamme) et par couleur.
model ConnectStockMinimum {
  id       Int           @id @default(autoincrement())
  clientId Int
  client   ConnectClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  groupe   String
  couleur  String
  minimum  Int

  @@unique([clientId, groupe, couleur])
  @@map("connect_stock_minimum")
}

// Un enregistrement par jour où le mail récapitulatif des alertes a été envoyé (évite les doublons).
model ConnectAlerteEnvoi {
  id         Int      @id @default(autoincrement())
  jour       String   @unique // AAAA-MM-JJ, heure de Paris
  envoyeLe   DateTime @default(now())
  nbAlertes  Int

  @@map("connect_alerte_envoi")
}

// Un PC chez un client sur lequel le programme résident est installé (historique conservé).
model ConnectPoste {
  id                Int           @id @default(autoincrement())
  clientId          Int
  client            ConnectClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  nom               String
  systeme           String?
  versionAgent      String?
  premiereConnexion DateTime      @default(now())
  derniereConnexion DateTime      @default(now())
  site              String        @default("Site principal") // les machines découvertes par cet ordinateur prennent ce site
  deconnexionSignaleLe DateTime? // mail de déconnexion déjà envoyé pour cet ordinateur
  // santé du programme, envoyée avec chaque signal de vie (version 1.1 et suivantes)
  demarreLe         DateTime?
  derniereLectureOk DateTime?
  derniereErreur    String?
  derniereErreurLe  DateTime?
  nbErreurs         Int           @default(0)

  @@unique([clientId, nom])
  @@map("connect_poste")
}

// Demande de lecture immédiate (bouton « Actualiser ») : le programme la prend à son prochain signal (≤ 1 min).
model ConnectCommande {
  id        Int           @id @default(autoincrement())
  clientId  Int
  client    ConnectClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  machineId Int?
  type      String        @default("lecture")
  creeLe    DateTime      @default(now())
  priseLe   DateTime?
  faiteLe   DateTime?
  posteNom  String?

  @@index([clientId, faiteLe])
  @@map("connect_commande")
}

// Historique du lien d'installation d'un client : chaque envoi (mail ou noté à la main) et chaque régénération.
model ConnectLienEvenement {
  id       Int           @id @default(autoincrement())
  clientId Int
  client   ConnectClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type     String // envoye | note | regenere
  detail   String? // adresse mail du destinataire...
  date     DateTime      @default(now())

  @@index([clientId, date])
  @@map("connect_lien_evenement")
}

// ---------------------------------------------------------------------------
// Financement : demandes de location financière et contrats en cours (tables préfixées fin_)
// Montants en centimes (entiers), coefficients en dix-millièmes (595 = 5,95 %).
// ---------------------------------------------------------------------------

model FinUtilisateur {
  id                  Int      @id @default(autoincrement())
  email               String   @unique
  prenom              String
  nom                 String
  motDePasseHash      String
  role                String // ADMIN | ASSISTANTE | COMMERCIAL
  actif               Boolean  @default(true)
  doitChangerMotDePasse Boolean @default(true)
  motDePasseChangeLe  DateTime @default(now()) // les sessions ouvertes avant cette date sont refusées
  creeLe              DateTime @default(now())

  demandesCommercial FinDemande[]    @relation("DemandeCommercial")
  demandesSaisies    FinDemande[]    @relation("DemandeSaisiePar")
  contrats           FinContrat[]
  grilles            FinGrille[]
  historique         FinHistorique[]
  piecesJointes      FinPieceJointe[]

  @@map("fin_utilisateur")
}

model FinFinanceur {
  id                      Int      @id @default(autoincrement())
  nom                     String   @unique
  connecteur              String   @default("manuel") // manuel | grenke_api | ...
  actif                   Boolean  @default(true)
  majorationMensuelleBp   Int      @default(150) // 1,5 % de majoration du coefficient en paiement mensuel
  commissionBp            Int? // information (2 % chez Grenke), non utilisée dans le calcul
  fraisDossierCentimes    Int      @default(0)

  grilles          FinGrille[]
  correspondances  FinCorrespondanceStatut[]
  demandes         FinDemande[]
  contrats         FinContrat[]

  @@map("fin_financeur")
}

// Code de statut propre au financeur -> statut commun
model FinCorrespondanceStatut {
  id             Int          @id @default(autoincrement())
  financeurId    Int
  financeur      FinFinanceur @relation(fields: [financeurId], references: [id], onDelete: Cascade)
  codeFinanceur  String
  statut         String

  @@unique([financeurId, codeFinanceur])
  @@map("fin_correspondance_statut")
}

// type REELLE : barème du financeur (utilisateurId vide).
// type COMMERCIALE : barème des commerciaux ; utilisateurId vide = barème commun, renseigné = barème propre à ce commercial.
// base : unité du coefficient (MENSUEL pour Grenke réel, TRIMESTRIEL pour le barème commercial).
model FinGrille {
  id            Int            @id @default(autoincrement())
  financeurId   Int
  financeur     FinFinanceur   @relation(fields: [financeurId], references: [id], onDelete: Cascade)
  utilisateurId Int?
  utilisateur   FinUtilisateur? @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  type          String // REELLE | COMMERCIALE
  base          String // MENSUEL | TRIMESTRIEL
  lignes        FinGrilleLigne[]

  @@index([financeurId, type])
  @@map("fin_grille")
}

// Une tranche court de son minimum jusqu'au minimum de la tranche suivante (la dernière n'a pas de limite).
model FinGrilleLigne {
  id                  Int       @id @default(autoincrement())
  grilleId            Int
  grille              FinGrille @relation(fields: [grilleId], references: [id], onDelete: Cascade)
  dureeMois           Int
  montantMinCentimes  Int
  coefficientBp       Int

  @@index([grilleId])
  @@map("fin_grille_ligne")
}

model FinDemande {
  id            Int      @id @default(autoincrement())
  reference     String   @unique // LEV-AAAA-NNNN
  creeLe        DateTime @default(now())
  majLe         DateTime @updatedAt
  statut        String   @default("BROUILLON")
  archivee      Boolean  @default(false)
  infosManquantes String? // pièces demandées par le financeur
  etapeSignature String? // étape précise quand le statut est « En signature » (voir lib/financement/etapes.ts)
  refFinanceur  String? // numéro de dossier chez le financeur

  financeurId   Int
  financeur     FinFinanceur   @relation(fields: [financeurId], references: [id])
  commercialId  Int
  commercial    FinUtilisateur @relation("DemandeCommercial", fields: [commercialId], references: [id])
  saisiParId    Int
  saisiPar      FinUtilisateur @relation("DemandeSaisiePar", fields: [saisiParId], references: [id])

  // client
  raisonSociale String
  siret         String   @default("") // vide tant qu'il n'est pas connu (obligatoire pour passer en « envoyée »)
  formeJuridique String? // SAS, SARL... (libellé libre, repris de la recherche d'entreprise)
  adresse       String
  codePostal    String?
  ville         String?
  pays          String   @default("France")
  contactPrenom String
  contactNom    String
  contactEmail  String
  contactTel    String?

  // financement
  dureeMois     Int
  periodicite   String // TRIMESTRIELLE | MENSUELLE
  loyerCentimes Int
  // calcul commercial (ce que voit le commercial)
  montantCommercialCentimes Int
  coefficientCommercialPpm  Int // coefficient par période réellement appliqué (majoration comprise), en millionièmes : 59500 = 5,95 %
  // calcul réel (jamais envoyé au commercial)
  montantReelCentimes       Int
  coefficientReelPpm        Int
  horsTranche   Boolean @default(false) // le montant calculé tombait entre deux tranches

  lignes        FinDemandeLigne[]
  pieces        FinPieceJointe[]
  historique    FinHistorique[]
  signature     FinSignature?
  contrat       FinContrat?

  @@index([commercialId])
  @@index([statut])
  @@map("fin_demande")
}

model FinDemandeLigne {
  id            Int        @id @default(autoincrement())
  demandeId     Int
  demande       FinDemande @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  designation   String
  quantite      Int        @default(1)
  montantHtCentimes Int? // optionnel : le montant à financer est déduit du loyer
  typeBien      String? // exigé par certains financeurs (ex. matériel informatique)
  constructeur  String?

  @@map("fin_demande_ligne")
}

model FinPieceJointe {
  id          Int            @id @default(autoincrement())
  demandeId   Int
  demande     FinDemande     @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  type        String // KBIS | BILAN | RIB | AUTRE
  nomFichier  String
  stockage    String // clé du fichier dans le stockage privé
  taille      Int
  ajouteParId Int
  ajoutePar   FinUtilisateur @relation(fields: [ajouteParId], references: [id])
  ajouteLe    DateTime       @default(now())

  @@map("fin_piece_jointe")
}

model FinHistorique {
  id             Int            @id @default(autoincrement())
  demandeId      Int
  demande        FinDemande     @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  date           DateTime       @default(now())
  auteurId       Int
  auteur         FinUtilisateur @relation(fields: [auteurId], references: [id])
  ancienStatut   String?
  nouveauStatut  String?
  commentaire    String?

  @@index([demandeId, date])
  @@map("fin_historique")
}

model FinSignature {
  id               Int        @id @default(autoincrement())
  demandeId        Int        @unique
  demande          FinDemande @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  clientPrenom     String
  clientNom        String
  clientEmail      String
  fournisseurPrenom String
  fournisseurNom   String
  fournisseurEmail String
  demandeeLe       DateTime   @default(now())
  signeeLe         DateTime?

  @@map("fin_signature")
}

model FinContrat {
  id            Int      @id @default(autoincrement())
  creeLe        DateTime @default(now())
  demandeId     Int?     @unique
  demande       FinDemande? @relation(fields: [demandeId], references: [id])
  importe       Boolean  @default(false)
  refFinanceur  String? // numéro de contrat chez le financeur
  statutFinanceur String? // statut tel que donné par le financeur à l'import (ex. RunningContract)

  financeurId   Int
  financeur     FinFinanceur   @relation(fields: [financeurId], references: [id])
  commercialId  Int
  commercial    FinUtilisateur @relation(fields: [commercialId], references: [id])

  raisonSociale String
  siret         String?
  materiel      String
  periodicite   String
  dureeMois     Int
  loyerCentimes Int // loyer payé par le client (commercial) ; pour un contrat importé, loyer du contrat Grenke
  dateDebut     DateTime? // 1er loyer : inconnu à la signature, renseigné ensuite
  dateFin       DateTime? // par défaut : 1er loyer + durée
  montantCommercialCentimes Int?
  montantReelCentimes       Int // montant financé par le financeur (jamais envoyé au commercial)

  @@index([commercialId])
  @@index([dateFin])
  @@map("fin_contrat")
}
