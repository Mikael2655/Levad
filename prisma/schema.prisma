generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SocialPost {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topic       String
  contentLI   String?
  contentIG   String?
  imagePrompt String?
  imageUrl    String?

  status      String   @default("draft") // draft | scheduled | published | failed
  scheduledAt DateTime?
  publishedAt DateTime?

  linkedinPostId  String?
  instagramPostId String?
  errorMessage    String?
}

model SocialConfig {
  id               Int      @id @default(1)
  companyName      String   @default("Levad")
  companyDesc      String   @default("Levad est spécialisé dans les solutions d'impression, téléphonie, informatique et GED pour les entreprises.")
  tone             String   @default("professionnel")
  targetAudience   String   @default("dirigeants et responsables IT de PME")
  topics           String   @default("impression,téléphonie,informatique,GED,productivité")
  notifyEmail      String   @default("mobadia@levad.fr")
  linkedinEnabled  Boolean  @default(false)
  instagramEnabled Boolean  @default(false)
  updatedAt        DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Levad Connect : suivi du parc de copieurs des clients (tables séparées de l'outil de publications)
// Script SQL à coller dans la console de la base : prisma/migrations/manual_connect_parc.sql
// ---------------------------------------------------------------------------

model ConnectClient {
  id       Int              @id @default(autoincrement())
  nom      String
  cle      String           @unique // nom simplifié (sans SARL/SAS, accents, majuscules) pour rapprocher les saisies
  creeLe   DateTime         @default(now())
  machines ConnectMachine[]
  mouvements ConnectStockMouvement[]

  @@map("connect_client")
}

model ConnectMachine {
  id          Int             @id @default(autoincrement())
  clientId    Int
  client      ConnectClient   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  cle         String          @unique // « sn:NUMERO_DE_SERIE » ou « ip:ID_CLIENT:ADRESSE_IP »
  numeroSerie String?
  marque      String?
  modele      String?
  ip          String?
  nomAffiche  String?
  categorie   String          @default("mine") // mine = Canon vendue par LEVAD, autre = autre marque
  aVerifier   Boolean         @default(false)
  recette     String? // A, B ou C ; vide = automatique
  seuilEncre  Int             @default(25) // ancien réglage unique (remplacé par un seuil par couleur)
  seuilNoir    Int            @default(25)
  seuilCyan    Int            @default(25)
  seuilMagenta Int            @default(25)
  seuilJaune   Int            @default(25)
  creeLe      DateTime        @default(now())
  releves     ConnectReleve[]

  @@index([clientId])
  @@map("connect_machine")
}

model ConnectReleve {
  id            Int            @id @default(autoincrement())
  machineId     Int
  machine       ConnectMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  date          DateTime       @default(now())
  source        String         @default("connect")
  compteurs     Json // { "112": { "v": 656, "nom": "Total (Black/Large)" }, ... }
  encres        Json?
  bacs          Json?
  totalStandard Int?
  versionSnmp   String?
  pc            String?

  @@index([machineId, date])
  @@map("connect_releve")
}

// Stock d'encre d'un client = somme des mouvements (envois +, changements de cartouche détectés -, corrections).
model ConnectStockMouvement {
  id        Int           @id @default(autoincrement())
  clientId  Int
  client    ConnectClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  couleur   String // noir | cyan | magenta | jaune
  delta     Int
  motif     String // envoi | correction | changement
  note      String? // référence de la cartouche, remarque...
  machineId Int?
  date      DateTime      @default(now())

  @@index([clientId, couleur])
  @@map("connect_stock_mouvement")
}

// Un enregistrement par jour où le mail récapitulatif des alertes a été envoyé (évite les doublons).
model ConnectAlerteEnvoi {
  id         Int      @id @default(autoincrement())
  jour       String   @unique // AAAA-MM-JJ, heure de Paris
  envoyeLe   DateTime @default(now())
  nbAlertes  Int

  @@map("connect_alerte_envoi")
}
