generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  firstName  String
  lastName   String
  email      String
  phone      String?
  company    String?
  jobTitle   String?

  product    String
  message    String?

  status     String   @default("nouveau")
  source     String   @default("formulaire")
  notes      String?
  assignedTo String?
}

// ---------------------------------------------------------------------------
// Pronostics de football
// ---------------------------------------------------------------------------

model Competition {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  name      String
  joinCode  String   @unique

  phases         Phase[]
  players        Player[]
  matches        Match[]
  bonusQuestions BonusQuestion[]
}

// Une phase porte son propre barème de points et sa propre règle de
// prolongation (ex: "Poules", "1/8 de finale", "Finale").
model Phase {
  id            Int     @id @default(autoincrement())
  competitionId Int
  name          String
  order         Int     @default(0)

  pointsExactScore     Int     @default(5)
  pointsGoalDifference Int     @default(3)
  pointsCorrectOutcome Int     @default(1)
  allowsExtraTime      Boolean @default(false)

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  matches     Match[]
}

// Un compte joueur appartient à une seule compétition (inscription par
// code d'accès propre à chaque compétition).
model Player {
  id            Int      @id @default(autoincrement())
  competitionId Int
  createdAt     DateTime @default(now())
  name          String
  email         String
  passwordHash  String
  role          String   @default("PLAYER") // "PLAYER" | "ADMIN"

  competition  Competition   @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  predictions  Prediction[]
  bonusAnswers BonusAnswer[]

  favoritesGiven Favorite[] @relation("FavoriteOwner")
  favoritedBy    Favorite[] @relation("FavoriteTarget")

  @@unique([competitionId, email])
}

model Match {
  id            Int      @id @default(autoincrement())
  competitionId Int
  phaseId       Int
  homeTeam      String
  awayTeam      String
  kickoff       DateTime
  status        String   @default("SCHEDULED") // "SCHEDULED" | "LIVE" | "FINISHED"

  // Score au terme des 90 minutes (ou du match si pas de prolongation).
  homeScoreFullTime Int?
  awayScoreFullTime Int?
  // Score au terme des 120 minutes, uniquement si la phase autorise les
  // prolongations et que ce match précis y est allé.
  homeScoreExtraTime Int?
  awayScoreExtraTime Int?

  competition Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  phase       Phase        @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  predictions Prediction[]
}

model Prediction {
  id        Int    @id @default(autoincrement())
  playerId  Int
  matchId   Int
  homeScore Int
  awayScore Int
  points    Int?

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([playerId, matchId])
}

model BonusQuestion {
  id            Int       @id @default(autoincrement())
  competitionId Int
  createdAt     DateTime  @default(now())
  question      String
  type          String    @default("TEXT") // "TEXT" | "CHOICE"
  options       String? // JSON array of strings, only for CHOICE
  points        Int       @default(3)
  deadline      DateTime?
  correctAnswer String?

  competition Competition   @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  answers     BonusAnswer[]
}

model BonusAnswer {
  id              Int    @id @default(autoincrement())
  playerId        Int
  bonusQuestionId Int
  answer          String
  points          Int?

  player        Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  bonusQuestion BonusQuestion @relation(fields: [bonusQuestionId], references: [id], onDelete: Cascade)

  @@unique([playerId, bonusQuestionId])
}

// Un joueur marque d'autres joueurs de sa compétition comme favoris pour
// se comparer à eux dans un classement filtré.
model Favorite {
  id              Int      @id @default(autoincrement())
  playerId        Int
  favoritePlayerId Int
  createdAt       DateTime @default(now())

  player         Player @relation("FavoriteOwner", fields: [playerId], references: [id], onDelete: Cascade)
  favoritePlayer Player @relation("FavoriteTarget", fields: [favoritePlayerId], references: [id], onDelete: Cascade)

  @@unique([playerId, favoritePlayerId])
}
