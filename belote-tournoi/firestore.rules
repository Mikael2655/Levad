/* Règles de sécurité Firestore pour le tournoi de belote.
 *
 * À coller dans la console Firebase : Firestore Database → Règles → Publier.
 *
 * Modèle : lecture publique (le classement est visible de tous) ; écriture
 * réservée aux utilisateurs authentifiés (connexion anonyme automatique).
 * L'accès équipe (QR) et l'accès administrateur (code) sont gérés côté
 * application ; ces règles se contentent d'exiger une session authentifiée.
 *
 * ⚠️ Adapté à un tournoi entre connaissances. Pour un usage public exposé,
 * renforcez avec des rôles (custom claims) et des Cloud Functions.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /tournaments/{tid} {
      allow read: if true;
      allow write: if request.auth != null;

      match /teams/{teamId} {
        allow read: if true;
        allow write: if request.auth != null;
      }

      match /matches/{matchId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
  }
}
