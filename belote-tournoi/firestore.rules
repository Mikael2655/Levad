/* Règles de sécurité Firestore pour le tournoi de belote.
 *
 * À coller dans la console Firebase : Firestore Database → Règles → Publier.
 *
 * Modèle : lecture publique (le classement est visible de tous) ; écriture
 * réservée aux utilisateurs authentifiés (connexion anonyme automatique).
 * Un chef ne peut réclamer qu'une place libre ou modifier sa propre équipe.
 *
 * ⚠️ L'accès administrateur est protégé par un code côté application, pas par
 * ces règles. C'est adapté à un tournoi entre connaissances. Pour un usage
 * public exposé, renforcez avec des rôles (custom claims) et des Cloud
 * Functions.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /tournaments/{tid} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;

      match /teams/{teamId} {
        allow read: if true;
        // Réclamer une place libre, ou modifier sa propre équipe.
        allow update: if request.auth != null && (
          resource.data.uid == null ||
          resource.data.uid == request.auth.uid ||
          request.resource.data.uid == request.auth.uid
        );
        allow create, delete: if request.auth != null;
      }

      match /matches/{matchId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
  }
}
