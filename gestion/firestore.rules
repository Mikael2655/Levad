/* Règles de sécurité Firestore — Levad Gestion (CRM/ERP interne).
 *
 * À coller dans la console Firebase : Firestore Database → Règles → Publier.
 * Le projet Firebase est partagé avec « proposition-commerciale » (même
 * FIREBASE_CONFIG) : si les deux outils sont utilisés en ligne, publiez
 * l'union des deux fichiers de règles (celui-ci + firestore.rules de
 * proposition-commerciale) — Firestore n'a qu'un seul jeu de règles actif
 * par projet.
 *
 * Modèle « confort », identique à proposition-commerciale : lecture/
 * écriture réservées aux utilisateurs authentifiés (connexion anonyme
 * automatique de l'application). Les rôles (admin / administratif /
 * commercial) et la restriction « un commercial ne voit que ses clients »
 * sont appliqués côté application, pas au niveau de la base.
 *
 * ⚠️ Pour un cloisonnement technique infaillible (empêcher un commercial
 * de lire les clients d'un autre au niveau de la base), il faudrait de
 * vrais comptes Firebase Auth par utilisateur + rôles (custom claims) +
 * règles conditionnelles, ou des Cloud Functions.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /gestion_users/{id} { allow read, write: if request.auth != null; }
    match /gestion_clients/{id} { allow read, write: if request.auth != null; }
    match /gestion_contracts/{id} { allow read, write: if request.auth != null; }
    match /gestion_machines/{id} { allow read, write: if request.auth != null; }
    match /gestion_meterReadings/{id} { allow read, write: if request.auth != null; }
    match /gestion_invoices/{id} { allow read, write: if request.auth != null; }
    match /gestion_sepaBatches/{id} { allow read, write: if request.auth != null; }
    match /gestion_counters/{id} { allow read, write: if request.auth != null; }
    match /gestion_settings/{id} { allow read, write: if request.auth != null; }
  }
}
